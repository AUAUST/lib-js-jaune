{
  "name": "@auaust/jaune",
  "version": "0.0.5",
  "description": "A Color class that helps you work with colors!",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AUAUST/lib-js-jaune.git"
  },
  "license": "UNLICENSED",
  "author": {
    "name": "Aurian Aubert",
    "email": "aurian@auaust.ch",
    "url": "https://auaust.ch"
  },
  "type": "module",
  "scripts": {
    "build": "engrenage tsdown && engrenage typecheck:dist && engrenage vitest:dist",
    "ci": "pnpm run ci:check && pnpm run ci:test && pnpm run ci:build",
    "ci:build": "pnpm run build",
    "ci:check": "engrenage sync --check && engrenage typecheck && engrenage eslint",
    "ci:test": "engrenage vitest",
    "coverage": "engrenage vitest:coverage",
    "format": "engrenage prettier",
    "lint": "engrenage eslint",
    "lint:check": "engrenage eslint",
    "lint:fix": "engrenage eslint:fix",
    "lint:suppress": "engrenage eslint:suppress",
    "prepare": "lefthook install",
    "ready": "pnpm install --frozen-lockfile && engrenage sync && pnpm run ci",
    "test": "engrenage vitest && engrenage typecheck",
    "typecheck": "engrenage typecheck"
  },
  "imports": {
    "#color/*": "./src/color/*.ts",
    "#computations/*": "./src/computations/*.ts",
    "#formats/*": "./src/formats/*.ts",
    "#gamut/*": "./src/gamut/*.ts",
    "#package.json": "./package.json",
    "#parse/*": "./src/parse/*.ts",
    "#space/*": "./src/space/*.ts",
    "#spaces/*": "./src/spaces/*.ts",
    "#tests/*": "./tests/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./channels": "./dist/channels.mjs",
    "./color": "./dist/color.mjs",
    "./gamut": "./dist/gamut.mjs",
    "./hex": "./dist/hex.mjs",
    "./hsl": "./dist/hsl.mjs",
    "./lab": "./dist/lab.mjs",
    "./metrics": "./dist/metrics.mjs",
    "./named": "./dist/named.mjs",
    "./oklab": "./dist/oklab.mjs",
    "./parse": "./dist/parse.mjs",
    "./random": "./dist/random.mjs",
    "./rgb": "./dist/rgb.mjs",
    "./space": "./dist/space.mjs",
    "./transformations": "./dist/transformations.mjs",
    "./xyz": "./dist/xyz.mjs"
  },
  "files": [
    "dist",
    "data",
    "src"
  ],
  "dependencies": {
    "@auaust/toolkit": "^0.8.0"
  },
  "devDependencies": {
    "@auaust/engrenage": "^0.14.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.0.0",
    "eslint": "^10.0.0",
    "jiti": "^2.7.0",
    "jscpd": "^5.0.0",
    "lefthook": "^2.0.0",
    "prettier": "^3.9.0",
    "tsdown": "0.23.1",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "sideEffects": false,
  "prettier": "@auaust/engrenage/prettier",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "restricted"
  }
}
